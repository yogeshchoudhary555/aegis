# Copy to .env and fill in. Never commit real keys.
# Nebius Token Factory (NVIDIA Nemotron) — get a key at https://dev.nebius.com/builders
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model ID is namespaced & case-sensitive — confirm the exact string in the Token Factory playground.
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Tavily web search — get a key at https://tavily.com
TAVILY_API_KEY=
# PROVIDER: auto (use Nebius when NEBIUS_API_KEY is set, else offline mock) | nebius | mock
PROVIDER=auto
MEMORY_DB=data/memory.db
PORT=8000
